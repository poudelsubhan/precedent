# Neo4j connection for the verified context graph
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j

# Qoder Agent SDK authenticates through your local Qoder CLI session.
# Run `qoder login` before starting the runner.
QODER_AUTH_METHOD=cli-session

CONSOLE_URL=http://localhost:3000
BROKER_URL=http://localhost:3001
RANGE_URL=http://localhost:3002
RUNNER_URL=http://localhost:3003
